{
  "name": "fraud-analytics-azure-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Synthetic fraud analytics with governed read-only queries, effective-dated policies and traceable evidence on Azure.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Carcamo-ben/fraud-analytics-azure-poc.git" },
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/*.browser.mjs",
    "preview": "node dev/local-preview.mjs",
    "seed:sql": "node seed/seed.mjs",
    "seed:search": "node seed/ingest.mjs",
    "acceptance:sql": "node seed/verify-readonly.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.29.0",
    "jose": "^6.1.0",
    "mssql": "^12.0.0"
  },
  "devDependencies": {
    "playwright": "1.59.1"
  }
}

{
  "type": "object",
  "additionalProperties": false,
  "required": ["supported", "request", "reason"],
  "properties": {
    "supported": { "type": "boolean" },
    "reason": { "type": "string", "enum": ["approved", "unsupported", "clarification_needed"] },
    "request": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "groupBy", "current", "previous"],
          "properties": {
            "kind": { "type": "string", "enum": ["loss_comparison", "rule_quality"] },
            "groupBy": { "type": "string", "enum": ["channel", "merchant", "province"] },
            "current": {
              "type": "object", "additionalProperties": false, "required": ["start", "end"],
              "properties": { "start": { "type": "string" }, "end": { "type": "string" } }
            },
            "previous": {
              "type": "object", "additionalProperties": false, "required": ["start", "end"],
              "properties": { "start": { "type": "string" }, "end": { "type": "string" } }
            }
          }
        }
      ]
    }
  }
}
